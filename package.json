{
  "name": "ez-dk-citizen",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "docker compose watch",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "build": "pnpm --recursive --if-present build",
    "db:generate": "pnpm --filter @ez-dk-citizen/data db:generate",
    "db:migrate": "docker compose exec hono-data pnpm --filter @ez-dk-citizen/data db:migrate",
    "db:up": "docker compose up --detach --wait postgres",
    "db:down": "docker compose down",
    "test": "pnpm --recursive --if-present test",
    "test:dev": "node scripts/test-container-development.mjs",
    "test:integration": "node scripts/test-postgres-integration.mjs"
  },
  "devDependencies": {
    "prettier": "^3.9.6"
  }
}
