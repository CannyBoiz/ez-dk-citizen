{
  "name": "ez-dk-citizen",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "docker compose watch",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "build": "pnpm --recursive --if-present build",
    "db:generate": "pnpm --filter @ez-dk-citizen/data db:generate",
    "db:migrate": "docker compose exec hono-data pnpm --filter @ez-dk-citizen/data db:migrate",
    "db:up": "docker compose up --detach --wait postgres",
    "db:down": "docker compose down",
    "test": "pnpm --recursive --if-present test",
    "test:dev": "node scripts/test-container-development.mjs",
    "test:integration": "node scripts/test-postgres-integration.mjs",
    "test:e2e": "node scripts/test-postgres-integration.mjs --end-to-end",
    "test:roles-anywhere": "node scripts/test-roles-anywhere-container.mjs",
    "test:live-s3": "node scripts/test-live-s3-browser.mjs --preflight && pnpm typecheck && pnpm test && pnpm test:dev && pnpm test:integration && pnpm test:e2e && pnpm build && node scripts/test-live-s3-browser.mjs"
  },
  "devDependencies": {
    "prettier": "^3.9.6"
  }
}
